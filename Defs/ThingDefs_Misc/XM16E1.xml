<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_AssaultRifle_T1">
		<defName>CGF1_MWP_XM16E1_</defName>
		<label>XM16E1</label>
		<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.</description>
		<graphicData>
			<texPath>CGF1/Gun/XM16E1</texPath>
			<drawSize>1.03</drawSize>
		</graphicData>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T8_AtomicAgeFirearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>60</Steel>
			<ComponentIndustrial>7</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>40000</WorkToMake>
			<Mass>3.6</Mass>
			<AccuracyTouch>0.60</AccuracyTouch>
			<AccuracyShort>0.60</AccuracyShort>
			<AccuracyMedium>0.55</AccuracyMedium>
			<AccuracyLong>0.50</AccuracyLong>
			<RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>40</equippedAngleOffset>
		<weaponTags>
			<li>CGF1_AR_Civilian</li>
			<li>CGF1_AR_Military</li>
			<li>CGF1_AR_Military_Advanced</li>
		</weaponTags>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarUSA</li>
			<li>CGF1_GunsGalore_ColdWarUSA_AR</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_556x45mmNATO_Auto</defaultProjectile>
				<warmupTime>1</warmupTime>
				<range>30.9</range>
				<burstShotCount>4</burstShotCount>
				<ticksBetweenBurstShots>6</ticksBetweenBurstShots>
				<soundCast>CGF1_MWP_SFX_Rifle_Auto12</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalshThree</def>
				<drawSize>(0.6,0.6)</drawSize>
				<offsets>
					<li>(0.65,0.06)</li>
				</offsets>
			</li>
		</modExtensions>
		<generateCommonality>0.05</generateCommonality> <!-- Uncommon -->
		<thingSetMakerTags>
			<li>CGF1_GunsGalore_RewardAncient_Common</li>
		</thingSetMakerTags>
		
		<comps>
			<li Class="WeaponVariants.CompProperties_WeaponVariants">
				<generateBaseWeapon>true</generateBaseWeapon>
				<variants>
					<li>
						<defName>CGF1_MWP_XM16E1_SionicsMAWA1</defName>
						<label>XM16E1 (Sionics MAW-A1)</label>
						<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.\n\nThis variant has an attached Sionics MAW-A1 suppressor.</description>
						<commonality>0.04</commonality> <!-- 1 in 25 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/XM16E1_SionicsMAWA1</texPath>
							<drawSize>1.2</drawSize>
						</graphicData>
						<statOffsets>
							<Mass>0.5</Mass> <!-- Sionics MAW-A1 Suppressor -->
						</statOffsets>
						<equippedStatOffsets>
							<HuntingStealth>0.5</HuntingStealth> <!-- 0.5 for suppressors -->
						</equippedStatOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<soundCast>CGF1_MWP_SFX_Rifle_Semi_SD1</soundCast>
								<muzzleFlashScale>-8</muzzleFlashScale>
							</li>
						</verbModifiers>
						<modExtensions>
							<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
								<def>CGF1_MF_StandardMuzzleFlashSD</def>
								<drawSize>(0.3,0.3)</drawSize>
								<offsets>
									<li>(0.81,0.07)</li>
								</offsets>
							</li>
						</modExtensions>
					</li>
					<li>
						<defName>CGF1_MWP_XM16E1_30Rnd</defName>
						<label>XM16E1 (30Rnd)</label>
						<description>Caliber: 5.56x45mm NATO. 30-round detachable mag. Select-Fire.\n\nThis variant uses a later production 30-round magazine.</description>
						<commonality>0.1</commonality> <!-- 1 in 10 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/XM16E1_30Rnd</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.05</Mass> <!-- 20 to 30Rnd -->
						</statOffsets>
					</li>
					<li>
						<defName>CGF1_MWP_XM16E1_30Rnd_SionicsMAWA1</defName>
						<label>XM16E1 (30Rnd Sionics MAW-A1)</label>
						<description>Caliber: 5.56x45mm NATO. 30-round detachable mag. Select-Fire.\n\nThis variant has an attached Sionics MAW-A1 suppressor and uses a later production 30-round magazine.</description>
						<commonality>0.04</commonality> <!-- 1 in 25 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/XM16E1_30Rnd_SionicsMAWA1</texPath>
							<drawSize>1.2</drawSize>
						</graphicData>
						<statOffsets>
							<Mass>0.55</Mass> <!-- Sionics MAW-A1 Suppressor + 20 to 30Rnd -->
						</statOffsets>
						<equippedStatOffsets>
							<HuntingStealth>0.5</HuntingStealth> <!-- 0.5 for suppressors -->
						</equippedStatOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<soundCast>CGF1_MWP_SFX_Rifle_Semi_SD1</soundCast>
								<muzzleFlashScale>-8</muzzleFlashScale>
							</li>
						</verbModifiers>
						<modExtensions>
							<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
								<def>CGF1_MF_StandardMuzzleFlashSD</def>
								<drawSize>(0.3,0.3)</drawSize>
								<offsets>
									<li>(0.81,0.07)</li>
								</offsets>
							</li>
						</modExtensions>
					</li>
					<li>
						<defName>CGF1_MWP_XM16E1_M203</defName>
						<label>XM16E1 M203</label>
						<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.\n\nThis variant has been fitted with an M203 grenade launcher.</description>
						<commonality>0.05</commonality> <!-- 1 in 20 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/XM16E1_M203</texPath>
						</graphicData>
						<statOffsets>
							<Mass>1.4</Mass> <!-- M203 -->
						</statOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<label>XM16E1</label>
								<commandIcon>CGF1/Gun/Variant/XM16E1_M203</commandIcon>
							</li>
						</verbModifiers>
						<addedVerbs>
							<li>
								<verbClass>Verb_Shoot</verbClass>
								<hasStandardCommand>true</hasStandardCommand>
								<defaultProjectile>CGF1_MWP_Bullet_40x46mm_Grenade</defaultProjectile>
								<warmupTime>3.5</warmupTime>
								<range>20.9</range>
								<forcedMissRadius>1.9</forcedMissRadius>
								<burstShotCount>1</burstShotCount>
								<soundCast>CGF1_MWP_SFX_GrenadeLauncher1</soundCast>
								<soundCastTail>GunTail_Medium</soundCastTail>
								<muzzleFlashScale>2</muzzleFlashScale>
								<targetParams>
									<canTargetLocations>true</canTargetLocations>
								</targetParams>
								<label>M203</label>
								<commandIcon>CGF1/Underbarrel/M203</commandIcon>
							</li>
						</addedVerbs>
					</li>
				</variants>
			</li>
		</comps>
	</ThingDef>
	
</Defs>