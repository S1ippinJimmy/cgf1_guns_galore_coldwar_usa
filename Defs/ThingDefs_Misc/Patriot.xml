<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_SMG_T1">
		<defName>CGF1_MWP_Patriot_</defName>
		<label>Patriot</label>
		<description>Caliber: 5.56x45mm NATO. 100-round detachable mag. Select-Fire.</description>
		<graphicData>
			<texPath>CGF1/Gun/Patriot</texPath>
			<drawSize>1.12</drawSize>
		</graphicData>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T9_SpaceAgeFirearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>65</Steel>
			<ComponentIndustrial>6</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>45000</WorkToMake>
			<Mass>2.8</Mass>
			<AccuracyTouch>0.85</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
			<AccuracyLong>0.20</AccuracyLong>
			<RangedWeapon_Cooldown>1.65</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>40</equippedAngleOffset>
		<weaponTags>
			<li>CGF1_AR_Military</li>
		</weaponTags>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarUSA</li>
			<li>CGF1_GunsGalore_ColdWarUSA_AR</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_556x45mmNATO_Auto</defaultProjectile>
				<warmupTime>0.9</warmupTime>
				<range>25.9</range>
				<burstShotCount>8</burstShotCount>
				<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
				<soundCast>CGF1_MWP_SFX_MG_Light4</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalshThree</def>
				<drawSize>(0.6,0.6)</drawSize>
				<offsets>
					<li>(0.5,0.05)</li>
				</offsets>
			</li>
		</modExtensions>
		<generateCommonality>0.0125</generateCommonality> <!-- Rare -->
		<possessionCount>1</possessionCount> <!-- Possession -->
		<thingSetMakerTags>
			<li>CGF1_GunsGalore_RewardAncient_Prototype</li>
		</thingSetMakerTags>
		
		<comps>
			<li Class="WeaponVariants.CompProperties_WeaponVariants">
				<generateBaseWeapon>true</generateBaseWeapon>
				<variants>
					<li>
						<defName>CGF1_MWP_Patriot_20Rnd</defName>
						<label>Patriot (20Rnd)</label>
						<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.\n\nThis variant uses a 20-round magazine.</description>
						<commonality>0.08</commonality> <!-- 1 in 12.5 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Patriot_20Rnd</texPath>
						</graphicData>
						<statOffsets>
							<Mass>-0.80</Mass> <!-- 100Rnd CMAG to 20Rnd -->
						</statOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<burstShotCount>-2</burstShotCount> <!-- -2 from lost drum mag -->
							</li>
						</verbModifiers>
					</li>
					<li>
						<defName>CGF1_MWP_Patriot_30Rnd</defName>
						<label>Patriot (30Rnd)</label>
						<description>Caliber: 5.56x45mm NATO. 30-round detachable mag. Select-Fire.\n\nThis variant uses a 30-round magazine.</description>
						<commonality>0.08</commonality> <!-- 1 in 12.5 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Patriot_30Rnd</texPath>
						</graphicData>
						<statOffsets>
							<Mass>-0.75</Mass> <!-- 100Rnd CMAG to 30Rnd -->
						</statOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<burstShotCount>-2</burstShotCount> <!-- -2 from lost drum mag -->
							</li>
						</verbModifiers>
					</li>
					<li>
						<defName>CGF1_MWP_Patriot_60Rnd</defName>
						<label>Patriot (60Rnd)</label>
						<description>Caliber: 5.56x45mm NATO. 60-round detachable mag. Select-Fire.\n\nThis variant uses a Surefire MAG5-60 quad-stack magazine.</description>
						<commonality>0.04</commonality> <!-- 1 in 25 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Patriot_60Rnd</texPath>
						</graphicData>
						<statOffsets>
							<Mass>-0.3</Mass> <!-- 100Rnd CMAG to 60Rnd Surefire -->
						</statOffsets>
					</li>
					<li>
						<defName>CGF1_MWP_Patriot_100Rnd</defName>
						<label>Patriot (100Rnd)</label>
						<description>Caliber: 5.56x45mm NATO. 100-round detachable mag. Select-Fire.\n\nThis variant uses a Surefire MAG5-100 quad-stack magazine.</description>
						<commonality>0.04</commonality> <!-- 1 in 25 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Patriot_100Rnd</texPath>
						</graphicData>
						<statOffsets>
							<Mass>-0.05</Mass> <!-- 100Rnd CMAG to 60Rnd Surefire -->
						</statOffsets>
					</li>
				</variants>
			</li>
		</comps>
	</ThingDef>
	
</Defs>