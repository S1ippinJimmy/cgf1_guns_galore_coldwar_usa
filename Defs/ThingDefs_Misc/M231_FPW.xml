<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_AssaultRifle_Carbine_T0">
		<defName>CGF1_MWP_M231_FPW_</defName>
		<label>M231 FPW</label>
		<description>Caliber: 5.56x45mm NATO. 30-round detachable mag. Select-Fire.</description>
		<graphicData>
			<texPath>CGF1/Gun/M231_FPW</texPath>
			<drawSize>1.1</drawSize>
		</graphicData>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T9_SpaceAgeFirearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>50</Steel>
			<ComponentIndustrial>6</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>40000</WorkToMake>
			<Mass>3.33</Mass>
			<AccuracyTouch>0.85</AccuracyTouch>
			<AccuracyShort>0.70</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
			<AccuracyLong>0.20</AccuracyLong>
			<RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>40</equippedAngleOffset>
		<weaponTags>
			<li>CGF1_AR_Military</li>
		</weaponTags>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarUSA</li>
			<li>CGF1_GunsGalore_ColdWarUSA_AR</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_556x45mmNATO_Auto</defaultProjectile>
				<warmupTime>0.9</warmupTime>
				<range>30.9</range>
				<burstShotCount>4</burstShotCount>
				<ticksBetweenBurstShots>3</ticksBetweenBurstShots>
				<soundCast>CGF1_MWP_SFX_Rifle_Auto11</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalshThree</def>
				<drawSize>(0.6,0.6)</drawSize>
				<offsets>
					<li>(0.63,0.05)</li>
				</offsets>
			</li>
		</modExtensions>
		<generateCommonality>0.05</generateCommonality> <!-- Uncommon -->
		<possessionCount>1</possessionCount> <!-- Possession -->
		<thingSetMakerTags>
			<li>CGF1_GunsGalore_RewardAncient_Common</li>
		</thingSetMakerTags>
		
		<comps>
			<li Class="WeaponVariants.CompProperties_WeaponVariants">
				<generateBaseWeapon>true</generateBaseWeapon>
				<variants>
					<li>
						<defName>CGF1_MWP_M231_FPW_20Rnd</defName>
						<label>M231 FPW (20Rnd)</label>
						<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.\n\nThis variant uses a 20-round magazine.</description>
						<commonality>0.02</commonality> <!-- 1 in 50 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/M231_FPW_20Rnd</texPath>
						</graphicData>
						<statOffsets>
							<Mass>-0.05</Mass> <!-- 30 to 20Rnd -->
						</statOffsets>
					</li>
					<li>
						<defName>M231_FPW_100RndCMAG</defName>
						<label>M231 FPW (100Rnd CMAG)</label>
						<description>Caliber: 5.56x45mm NATO. 100-round detachable mag. Select-Fire.\n\nThis variant has been fitted with a 100-round Beta C-Mag.</description>
						<commonality>0.02</commonality> <!-- 1 in 50 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/M231_FPW_100RndCMAG</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.75</Mass> <!-- 30 to 100Rnd CMAG -->
						</statOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<burstShotCount>2</burstShotCount> <!-- +2 from drum mag -->
							</li>
						</verbModifiers>
					</li>
				</variants>
			</li>
		</comps>
	</ThingDef>
	
</Defs>