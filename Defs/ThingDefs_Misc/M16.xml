						<commonality>0.04</commonality> <!-- 1 in 25 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/M16_Bayonet</texPath>
							<drawSize>1.15</drawSize>
						</graphicData>
						<statOffsets>
							<Mass>0.1</Mass> <!-- M7 Bayonet -->
						</statOffsets>
						<replaceTools>true</replaceTools>
						<tools>
							<li>
								<label>stock</label>
								<capacities>
									<li>Blunt</li>
								</capacities>
								<power>10</power>
								<cooldownTime>2</cooldownTime>
							</li>
							<li>
								<label>bayonet</label>
