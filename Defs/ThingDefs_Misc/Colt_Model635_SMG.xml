<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_SMG_T1">
		<defName>CGF1_MWP_Colt_Model635_SMG_</defName>
		<label>Colt Model 635 SMG</label>
		<description>Caliber: 9x19mm Parabellum. 32-round detachable mag. Select-Fire.</description>
		<graphicData>
			<texPath>CGF1/Gun/Colt_Model635_SMG</texPath>
			<drawSize>1.07</drawSize>
		</graphicData>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T9_SpaceAgeFirearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>60</Steel>
			<ComponentIndustrial>4</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>25000</WorkToMake>
			<Mass>3.1</Mass>
			<AccuracyTouch>0.85</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
			<AccuracyLong>0.20</AccuracyLong>
			<RangedWeapon_Cooldown>1.65</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>40</equippedAngleOffset>
		<weaponTags>
			<li>CGF1_SMG_Civilian</li>
			<li>CGF1_SMG_Military</li>
			<li>CGF1_SMG_Military_Advanced</li>
		</weaponTags>
		<weaponClasses>
			<li>ShortShots</li>
			<li>RangedLight</li>
		</weaponClasses>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarUSA</li>
			<li>CGF1_GunsGalore_ColdWarUSA_SMG</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_9x19mmParabellum_Pistol</defaultProjectile>
				<warmupTime>0.9</warmupTime>
				<range>25.9</range>
				<burstShotCount>5</burstShotCount>
				<ticksBetweenBurstShots>6</ticksBetweenBurstShots>
				<soundCast>CGF1_MWP_SFX_Pistol1</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.7,0.7)</drawSize>
				<offsets>
					<li>(0.43,0.05)</li>
				</offsets>
			</li>
		</modExtensions>
		<generateCommonality>0.20</generateCommonality> <!-- Common -->
		<possessionCount>1</possessionCount> <!-- Possession -->
		<thingSetMakerTags>
			<li>CGF1_GunsGalore_RewardAncient_Common</li>
		</thingSetMakerTags>
		
		<comps>
			<li Class="WeaponVariants.CompProperties_WeaponVariants">
				<generateBaseWeapon>true</generateBaseWeapon>
				<variants>
					<li>
						<defName>Colt_Model635_SMG_SD</defName>
						<label>Colt Model 635 SMG (SD)</label>
						<description>Caliber: 9x19mm Parabellum. 32-round detachable mag. Select-Fire.\n\nThis variant has an attached suppressor.</description>
						<commonality>0.1</commonality> <!-- 1 in 10 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model635_SMG_SD</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.2</Mass> <!-- Suppressor -->
						</statOffsets>
						<equippedStatOffsets>
							<HuntingStealth>0.5</HuntingStealth> <!-- 0.5 for suppressors -->
						</equippedStatOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<soundCast>CGF1_MWP_SFX_SMG_SD1</soundCast>
								<muzzleFlashScale>-8</muzzleFlashScale>
							</li>
						</verbModifiers>
						<modExtensions>
							<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
								<def>CGF1_MF_StandardMuzzleFlashSD</def>
								<drawSize>(0.3,0.3)</drawSize>
								<offsets>
									<li>(0.7,0.05)</li>
								</offsets>
							</li>
						</modExtensions>
					</li>
					<li>
						<defName>CGF1_MWP_Colt_Model635_SMG_20Rnd</defName>
						<label>Colt Model 635 SMG (20Rnd)</label>
						<description>Caliber: 9x19mm Parabellum. 20-round detachable mag. Select-Fire.\n\nThis variant uses a 20-round magazine.</description>
						<commonality>0.4</commonality> <!-- 1 in 2.5 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model635_SMG_20Rnd</texPath>
						</graphicData>
						<statOffsets>
							<Mass>-0.1</Mass> <!-- 32 to 20Rnd -->
						</statOffsets>
					</li>
					<li>
						<defName>CGF1_MWP_Colt_Model635_SMG_50Rnd</defName>
						<label>Colt Model 635 SMG (50Rnd)</label>
						<description>Caliber: 9x19mm Parabellum. 50-round detachable mag. Select-Fire.\n\nThis variant uses a 50-round drum magazine.</description>
						<commonality>0.08</commonality> <!-- 1 in 12.5 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model635_SMG_50Rnd</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.3</Mass> <!-- 32 to 50Rnd -->
						</statOffsets>
					</li>
					<li>
						<defName>CGF1_MWP_Colt_Model635_SMG_Scope</defName>
						<label>Colt Model 635 SMG (Scope)</label>
						<description>Caliber: 9x19mm Parabellum. 32-round detachable mag. Select-Fire.\n\nThis variant has an attached Colt 3x20 scope.</description>
						<commonality>0.1</commonality> <!-- 1 in 10 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model635_SMG_Scope</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.1</Mass> <!-- Colt 3x20 (0.1) -->
						</statOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<range>3</range>
								<warmupTime>0.15</warmupTime>
							</li>
						</verbModifiers>
					</li>
					<li>
						<defName>CGF1_MWP_Colt_Model635_SMG_Scope_SD</defName>
						<label>Colt Model 635 SMG (Scope SD)</label>
						<description>Caliber: 9x19mm Parabellum. 32-round detachable mag. Select-Fire.\n\nThis variant has an attached Colt 3x20 scope and an attached suppressor.</description>
						<commonality>0.05</commonality> <!-- 1 in 20 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model635_SMG_Scope_SD</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.3</Mass> <!-- Colt 3x20 (0.1) + Suppressor (0.2) -->
						</statOffsets>
						<equippedStatOffsets>
							<HuntingStealth>0.5</HuntingStealth> <!-- 0.5 for suppressors -->
						</equippedStatOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<soundCast>CGF1_MWP_SFX_SMG_SD1</soundCast>
								<muzzleFlashScale>-8</muzzleFlashScale>
								<range>3</range>
								<warmupTime>0.15</warmupTime>
							</li>
						</verbModifiers>
						<modExtensions>
							<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
								<def>CGF1_MF_StandardMuzzleFlashSD</def>
								<drawSize>(0.3,0.3)</drawSize>
								<offsets>
									<li>(0.7,0.05)</li>
								</offsets>
							</li>
						</modExtensions>
					</li>
					<li>
						<defName>CGF1_MWP_Colt_Model635_SMG_CienerOU</defName>
						<label>Colt Model 635 SMG Ciener O/U</label>
						<description>Caliber: 9x19mm Parabellum. 32-round detachable mag. Select-Fire.\n\nThis variant has been fitted with a Ciener O/U shotgun.</description>
						<commonality>0.01</commonality> <!-- 1 in 100 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model635_SMG_CienerOU</texPath>
						</graphicData>
						<statOffsets>
							<Mass>2.4</Mass> <!-- Ciener O/U -->
						</statOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<label>M635</label>
								<commandIcon>CGF1/Gun/Variant/Colt_Model635_SMG_CienerOU</commandIcon>
							</li>
						</verbModifiers>
						<addedVerbs>
							<li>
								<verbClass>Verb_Shoot</verbClass>
								<hasStandardCommand>true</hasStandardCommand>
								<defaultProjectile>CGF1_MWP_Bullet_12Gauge_Slug_Shotgun</defaultProjectile>
								<warmupTime>1</warmupTime>
								<range>12.9</range>
								<soundCast>CGF1_MWP_SFX_Shotgun1</soundCast>
								<soundCastTail>GunTail_Heavy</soundCastTail>
								<muzzleFlashScale>9</muzzleFlashScale>
								<label>Ciener O/U</label>
								<commandIcon>CGF1/Underbarrel/CienerUltimate_OU</commandIcon>
							</li>
						</addedVerbs>
						<modExtensions>
							<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
								<def>MF_StandardMuzzleFalsh</def>
								<drawSize>(0.7,0.7)</drawSize>
								<offsets>
									<li>(0.33,0.05)</li>
								</offsets>
							</li>
						</modExtensions>
					</li>
				</variants>
			</li>
		</comps>
	</ThingDef>
	
</Defs>