<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_AssaultRifle_Carbine_T1">
		<defName>CGF1_MWP_M3_Carbine_</defName>
		<label>M3 Carbine</label>
		<description>Caliber: .30 Carbine. 30-round detachable mag. Select-Fire.</description>
		<graphicData>
			<texPath>CGF1/Gun/M3_Carbine</texPath>
			<drawSize>1.06</drawSize>
		</graphicData>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T7_WW2Firearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>75</Steel>
			<ComponentIndustrial>9</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>40000</WorkToMake>
			<Mass>5.8</Mass>
			<AccuracyTouch>0.65</AccuracyTouch>
			<AccuracyShort>0.60</AccuracyShort>
			<AccuracyMedium>0.55</AccuracyMedium>
			<AccuracyLong>0.45</AccuracyLong>
			<RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>40</equippedAngleOffset>
		<weaponTags>
			<li>CGF1_AR_Civilian</li>
			<li>CGF1_AR_Military</li>
			<li>CGF1_AR_Military_Advanced</li>
		</weaponTags>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarUSA</li>
			<li>CGF1_GunsGalore_ColdWarUSA_AR</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_30Carbine_Auto</defaultProjectile>
				<warmupTime>1.4</warmupTime>
				<range>36.9</range>
				<burstShotCount>3</burstShotCount>
				<ticksBetweenBurstShots>7</ticksBetweenBurstShots>
				<soundCast>CGF1_MWP_SFX_Rifle_Semi5</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.5,0.5)</drawSize>
				<offsets>
					<li>(0.52,0.06)</li>
				</offsets>
			</li>
		</modExtensions>
		<generateCommonality>0.05</generateCommonality> <!-- Uncommon -->
		
		<comps>
			<li Class="WeaponVariants.CompProperties_WeaponVariants">
				<generateBaseWeapon>true</generateBaseWeapon>
				<variants>
					<li>
						<defName>CGF1_MWP_M3_Carbine_M2</defName>
						<label>M3 Carbine (M2)</label>
						<description>Caliber: .30 Carbine. 30-round detachable mag. Select-Fire.\n\nThis variant has an earlier M2 scope attached.</description>
						<commonality>0.5</commonality> <!-- 1 in 2 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/M3_Carbine_M2</texPath>
						</graphicData>
					</li>
					<li>
						<defName>CGF1_MWP_M3_Carbine_Irons</defName>
						<label>M3 Carbine (Irons)</label>
						<description>Caliber: .30 Carbine. 30-round detachable mag. Select-Fire.\n\nThis variant has had its optic setup removed.</description>
						<commonality>0.02</commonality> <!-- 1 in 50 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/M3_Carbine_Irons</texPath>
						</graphicData>
						<statOffsets>
							<Mass>-2.9</Mass> <!-- Removed IR scope -->
						</statOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<range>-6</range>
								<warmupTime>-0.5</warmupTime>
								<burstShotCount>1</burstShotCount>
							</li>
						</verbModifiers>
					</li>
				</variants>
			</li>
		</comps>
	</ThingDef>

</Defs>