<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_AssaultRifle_Carbine_T1">
		<defName>CGF1_MWP_Colt_Model608_</defName>
		<label>Colt Model 608</label>
		<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.</description>
		<graphicData>
			<texPath>CGF1/Gun/Colt_Model608</texPath>
			<drawSize>1.07</drawSize>
		</graphicData>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T8_AtomicAgeFirearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>50</Steel>
			<ComponentIndustrial>7</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>40000</WorkToMake>
			<Mass>2.65</Mass>
			<AccuracyTouch>0.65</AccuracyTouch>
			<AccuracyShort>0.60</AccuracyShort>
			<AccuracyMedium>0.55</AccuracyMedium>
			<AccuracyLong>0.45</AccuracyLong>
			<RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>40</equippedAngleOffset>
		<weaponTags>
			<li>CGF1_AR_Military</li>
			<li>CGF1_AR_Military_Advanced</li>
		</weaponTags>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarUSA</li>
			<li>CGF1_GunsGalore_ColdWarUSA_AR</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_556x45mmNATO_Auto</defaultProjectile>
				<warmupTime>0.9</warmupTime>
				<range>30.9</range>
				<burstShotCount>4</burstShotCount>
				<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
				<soundCast>CGF1_MWP_SFX_Rifle_Auto11</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.6,0.6)</drawSize>
				<offsets>
					<li>(0.46,0.05)</li>
				</offsets>
			</li>
		</modExtensions>
		<generateCommonality>0.0125</generateCommonality> <!-- Rare -->
		<thingSetMakerTags>
			<li>CGF1_GunsGalore_RewardAncient_Prototype</li>
		</thingSetMakerTags>
		
		<comps>
			<li Class="WeaponVariants.CompProperties_WeaponVariants">
				<generateBaseWeapon>true</generateBaseWeapon>
				<variants>
					<li>
						<defName>CGF1_MWP_Colt_Model608_30Rnd</defName>
						<label>Colt Model 608 (30Rnd)</label>
						<description>Caliber: 5.56x45mm NATO. 30-round detachable mag. Select-Fire.\n\nThis variant uses a later production 30-round magazine.</description>
						<commonality>0.02</commonality> <!-- 1 in 50 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model608_30Rnd</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.05</Mass> <!-- 20 to 30Rnd -->
						</statOffsets>
					</li>
					<li>
						<defName>CGF1_MWP_Colt_Model608_Scope</defName>
						<label>Colt Model 608 (Scope)</label>
						<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.\n\nThis variant has an attached Colt 3x20 scope.</description>
						<commonality>0.01</commonality> <!-- 1 in 100 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model608_Scope</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.1</Mass> <!-- Colt 3x20 -->
						</statOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<range>3.9</range>
								<warmupTime>0.15</warmupTime>
							</li>
						</verbModifiers>
					</li>
					<li>
						<defName>CGF1_MWP_Colt_Model608_BFH</defName>
						<label>Colt Model 608 BFH</label>
						<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.\n\nThis variant replaces the standard 607-style moderator with a birdcage-style flash hider as used on the later M16A1.</description>
						<commonality>0.01</commonality> <!-- 1 in 100 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model608_BFH</texPath>
						</graphicData>
					</li>
					<li>
						<defName>CGF1_MWP_Colt_Model608_CFH</defName>
						<label>Colt Model 608 CFH</label>
						<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.\n\nThis variant replaces the standard 607-style moderator with the experimental conical flash hider developed for the Colt Model 608.</description>
						<commonality>1</commonality> <!-- 1 in 1 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model608_CFH</texPath>
						</graphicData>
					</li>
					<li>
						<defName>CGF1_MWP_Colt_Model608_DFH</defName>
						<label>Colt Model 608 DFH</label>
						<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.\n\nThis variant replaces the standard 607-style moderator with a three prong/"duckbill"-style flash hider as used on the M16.</description>
						<commonality>0.05</commonality> <!-- 1 in 20 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model608_DFH</texPath>
						</graphicData>
					</li>
					<li>
						<defName>CGF1_MWP_Colt_Colt_Model608_FG</defName>
						<label>Colt Model 608 FG</label>
						<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.\n\nThis variant has a full-sized pistol grip that hasn't been cut down.</description>
						<commonality>0.1</commonality> <!-- 1 in 10 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model608_FG</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.05</Mass> <!-- Longer pistol grip -->
						</statOffsets>
					</li>
					<li>
						<defName>CGF1_MWP_Colt_Colt_Model608_FG_CFH</defName>
						<label>Colt Model 608 FG CFH</label>
						<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.\n\nThis variant has a full-sized pistol grip that hasn't been cut down and replaces the standard 607-style moderator with the experimental conical flash hider developed for the Colt Model 608.</description>
						<commonality>0.1</commonality> <!-- 1 in 10 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model608_FG_CFH</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.05</Mass> <!-- Longer pistol grip -->
						</statOffsets>
					</li>
					<li>
						<defName>CGF1_MWP_Colt_Colt_Model608_Stubby</defName>
						<label>Colt Model 608 Stubby</label>
						<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.\n\nThis variant's pistol grip has been cut down even further than the standard model.</description>
						<commonality>0.5</commonality> <!-- 1 in 2 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model608_Stubby</texPath>
						</graphicData>
					</li>
					<li>
						<defName>CGF1_MWP_Colt_Colt_Model608_Stubby_CFH</defName>
						<label>Colt Model 608 Stubby</label>
						<description>Caliber: 5.56x45mm NATO. 20-round detachable mag. Select-Fire.\n\nThis variant's pistol grip has been cut down even further than the standard modeland replaces the standard 607-style moderator with the experimental conical flash hider developed for the Colt Model 608.</description>
						<commonality>0.5</commonality> <!-- 1 in 2 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/Colt_Model608_Stubby_CFH</texPath>
						</graphicData>
					</li>
				</variants>
			</li>
		</comps>
	</ThingDef>
	
	
</Defs>