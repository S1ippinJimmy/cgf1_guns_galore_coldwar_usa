							<texPath>CGF1/Gun/Variant/XM106_100RndCMAG</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.75</Mass> <!-- 30 to 100Rnd CMAG -->
						</statOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<burstShotCount>2</burstShotCount> <!-- +2 from drum mag -->
							</li>
						</verbModifiers>
