<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_Rifle_BoltActionSniper_T0">
		<defName>CGF1_MWP_M40_</defName>
		<label>M40</label>
		<description>Caliber: 7.62x51mm NATO. 5-round internal mag. Bolt-Action.</description>
		<graphicData>
			<texPath>CGF1/Gun/M40</texPath>
			<drawSize>1.10</drawSize>
		</graphicData>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T8_AtomicAgeFirearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>7</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>60</Steel>
			<ComponentIndustrial>8</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>45000</WorkToMake>
			<Mass>6.5</Mass>
			<AccuracyTouch>0.50</AccuracyTouch>
			<AccuracyShort>0.70</AccuracyShort>
			<AccuracyMedium>0.86</AccuracyMedium>
			<AccuracyLong>0.88</AccuracyLong>
			<RangedWeapon_Cooldown>2.3</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>40</equippedAngleOffset>
		<weaponTags>
			<li>CGF1_SniperRifle</li>
		</weaponTags>
		<weaponClasses>
			<li>LongShots</li>
		</weaponClasses>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarUSA</li>
			<li>CGF1_GunsGalore_ColdWarUSA_Sniper</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_762x51mmNATO_Sniper</defaultProjectile>
				<warmupTime>3.5</warmupTime>
				<range>44.9</range>
				<soundCast>CGF1_MWP_SFX_Rifle_Bolt3</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.9,0.9)</drawSize>
				<offsets>
					<li>(0.60,0.09)</li>
				</offsets>
			</li>
		</modExtensions>
		<generateCommonality>0.20</generateCommonality> <!-- Common -->
		<possessionCount>1</possessionCount> <!-- Possession -->
		
		<comps>
			<li Class="WeaponVariants.CompProperties_WeaponVariants">
				<generateBaseWeapon>true</generateBaseWeapon>
				<variants>
					<li>
						<defName>CGF1_MWP_M40_SD</defName>
						<label>M40 (SD)</label>
						<description>Caliber: 7.62x51mm NATO. 5-round internal mag. Bolt-Action.\n\nThis variant has an attached suppressor.</description>
						<commonality>0.05</commonality> <!-- 1 in 20 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/M40_SD</texPath>
							<drawSize>1.15</drawSize>
						</graphicData>
						<statOffsets>
							<Mass>0.2</Mass> <!-- Suppressor -->
						</statOffsets>
						<equippedStatOffsets>
							<HuntingStealth>0.5</HuntingStealth> <!-- 0.5 for suppressors -->
						</equippedStatOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<soundCast>CGF1_MWP_SFX_Rifle_Semi_SD1</soundCast>
								<muzzleFlashScale>-8</muzzleFlashScale>
							</li>
						</verbModifiers>
						<modExtensions>
							<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
								<def>CGF1_MF_StandardMuzzleFlashSD</def>
								<drawSize>(0.3,0.3)</drawSize>
								<offsets>
									<li>(0.77,0.07)</li>
								</offsets>
							</li>
						</modExtensions>
					</li>
					<li>
						<defName>CGF1_MWP_M40_Irons</defName>
						<label>M40 (Irons)</label>
						<description>Caliber: 7.62x51mm NATO. 5-round internal mag. Bolt-Action.\n\nThis variant has had its scope removed.</description>
						<commonality>0.02</commonality> <!-- 1 in 50 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/M40_Irons</texPath>
						</graphicData>
						<statOffsets>
							<Mass>-0.4</Mass> <!-- Scope Removed -->
							<AccuracyTouch>0.15</AccuracyTouch>
							<AccuracyShort>0.10</AccuracyShort>
							<AccuracyMedium>0.04</AccuracyMedium>
							<AccuracyLong>-0.03</AccuracyLong>
							<RangedWeapon_Cooldown>-0.8</RangedWeapon_Cooldown>
						</statOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<defaultProjectile>CGF1_MWP_Bullet_762x51mmNATO_Rifle</defaultProjectile>
								<range>-8</range>
								<warmupTime>-1.8</warmupTime>
							</li>
						</verbModifiers>
					</li>
					<li>
						<defName>CGF1_MWP_M40_ANPVS2</defName>
						<label>M40 (AN/PVS-2)</label>
						<description>Caliber: 7.62x51mm NATO. 5-round internal mag. Bolt-Action.\n\nThis variant has an attached AN/PVS-2 "Starlight" scope.</description>
						<commonality>0.05</commonality> <!-- 1 in 20 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/M40_ANPVS2</texPath>
						</graphicData>
						<statOffsets>
							<Mass>2.7</Mass> <!-- AN/PVS-2 -->
						</statOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<range>3</range>
								<warmupTime>0.15</warmupTime>
							</li>
						</verbModifiers>
					</li>
				</variants>
			</li>
		</comps>
	</ThingDef>
	
</Defs>