<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_AssaultRifle_Carbine_T1">
		<defName>CGF1_MWP_M2_Carbine_PW_</defName>
		<label>M2 Carbine PW</label>
		<description>Caliber: .30 Carbine. 30-round detachable mag. Select-Fire.</description>
		<graphicData>
			<texPath>CGF1/Gun/M2_Carbine_PW</texPath>
			<drawSize>1.06</drawSize>
		</graphicData>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T7_WW2Firearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>55</Steel>
			<ComponentIndustrial>7</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>30000</WorkToMake>
			<Mass>2.8</Mass>
			<AccuracyTouch>0.65</AccuracyTouch>
			<AccuracyShort>0.60</AccuracyShort>
			<AccuracyMedium>0.55</AccuracyMedium>
			<AccuracyLong>0.45</AccuracyLong>
			<RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>40</equippedAngleOffset>
		<weaponTags>
			<li>CGF1_AR_Civilian</li>
			<li>CGF1_AR_Military</li>
			<li>CGF1_AR_Military_Advanced</li>
		</weaponTags>
		<weaponClasses>
			<li>RangedLight</li>
		</weaponClasses>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarUSA</li>
			<li>CGF1_GunsGalore_ColdWarUSA_AR</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_30Carbine_Auto</defaultProjectile>
				<warmupTime>0.9</warmupTime>
				<range>30.9</range>
				<burstShotCount>4</burstShotCount>
				<ticksBetweenBurstShots>7</ticksBetweenBurstShots>
				<soundCast>CGF1_MWP_SFX_Rifle_Semi5</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.5,0.5)</drawSize>
				<offsets>
					<li>(0.52,0.06)</li>
				</offsets>
			</li>
		</modExtensions>
		<generateCommonality>0.5</generateCommonality> <!-- Abundant -->
		<thingSetMakerTags>
			<li>CGF1_GunsGalore_RewardAncient_Common</li>
		</thingSetMakerTags>
		
		<comps>
			<li Class="WeaponVariants.CompProperties_WeaponVariants">
				<generateBaseWeapon>true</generateBaseWeapon>
				<variants>
					<li>
						<defName>CGF1_MWP_M2_Carbine_PW_Bayonet</defName>
						<label>M2 Carbine PW (Bayonet)</label>
						<description>Caliber: .30 Carbine. 30-round detachable mag. Select-Fire.\n\nThis variant has an attached M4 bayonet.</description>
						<commonality>0.08</commonality> <!-- 1 in 12.5 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/M2_Carbine_PW_Bayonet</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.1</Mass> <!-- M4 Bayonet -->
						</statOffsets>
						<replaceTools>true</replaceTools>
						<tools>
							<li>
								<label>stock</label>
								<capacities>
									<li>Blunt</li>
								</capacities>
								<power>10</power>
								<cooldownTime>2</cooldownTime>
							</li>
							<li>
								<label>bayonet</label>
								<capacities>
									<li>Stab</li>
								</capacities>
								<power>13</power>
								<cooldownTime>2</cooldownTime>
							</li>
						</tools>
						<modExtensions>
							<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
								<def>MF_StandardMuzzleFalsh</def>
								<drawSize>(0.5,0.5)</drawSize>
								<offsets>
									<li>(0.45,0.07)</li>
								</offsets>
							</li>
						</modExtensions>
					</li>
					<li>
						<defName>CGF1_MWP_M2_Carbine_PW_SD</defName>
						<label>M2 Carbine PW (SD)</label>
						<description>Caliber: .30 Carbine. 30-round detachable mag. Select-Fire.\n\nThis variant has an attached suppressor.</description>
						<commonality>0.04</commonality> <!-- 1 in 25 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/M2_Carbine_PW_SD</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.2</Mass> <!-- Suppressor -->
						</statOffsets>
						<equippedStatOffsets>
							<HuntingStealth>0.5</HuntingStealth> <!-- 0.5 for suppressors -->
						</equippedStatOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<soundCast>CGF1_MWP_SFX_Rifle_Semi_SD1</soundCast>
								<muzzleFlashScale>-8</muzzleFlashScale>
							</li>
						</verbModifiers>
						<modExtensions>
							<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
								<def>CGF1_MF_StandardMuzzleFlashSD</def>
								<drawSize>(0.3,0.3)</drawSize>
								<offsets>
									<li>(0.7,0.06)</li>
								</offsets>
							</li>
						</modExtensions>
					</li>
					<li>
						<defName>CGF1_MWP_M2_Carbine_PW_M8</defName>
						<label>M2 Carbine PW (M8)</label>
						<description>Caliber: 22mm Rifle Grenade. Single-shot.\n\nThis variant has an attached M8 rifle grenade projector.</description>
						<commonality>0.04</commonality> <!-- 1 in 20 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/M2_Carbine_PW_M8</texPath>
						</graphicData>
						<statOffsets>
							<Mass>0.3</Mass> <!-- M8 Grenade Projector -->
							<RangedWeapon_Cooldown>1.9</RangedWeapon_Cooldown> <!-- Rifle Grenade -->
						</statOffsets>
						<addedVerbs>
							<li>
								<verbClass>Verb_Shoot</verbClass>
								<hasStandardCommand>true</hasStandardCommand>
								<defaultProjectile>CGF1_MWP_Bullet_22mm_M17_RifleGrenade</defaultProjectile>
								<forcedMissRadius>0.9</forcedMissRadius>
								<warmupTime>3</warmupTime>
								<ai_AvoidFriendlyFireRadius>2</ai_AvoidFriendlyFireRadius>
								<range>25.9</range>
								<soundCast>CGF1_MWP_SFX_GrenadeLauncher2</soundCast>
								<soundCastTail>GunTail_Heavy</soundCastTail>
								<onlyManualCast>true</onlyManualCast>
								<targetParams>
									<canTargetLocations>true</canTargetLocations>
								</targetParams>
								<muzzleFlashScale>14</muzzleFlashScale>
								<label>M8</label>
								<commandIcon>CGF1/Gun/Variant/M1_Carbine_PW_M8</commandIcon>
							</li>
						</addedVerbs>
						<removedVerbs>
							<li>M2 Carbine</li>
						</removedVerbs>
						<modExtensions>
							<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
								<def>CGF1_MF_StandardMuzzleFlashSD</def>
								<drawSize>(0.3,0.3)</drawSize>
								<offsets>
									<li>(0.7,0.06)</li>
								</offsets>
							</li>
						</modExtensions>
					</li>
					<li>
						<defName>CGF1_MWP_M1_Carbine_PW_15Rnd</defName>
						<label>M1 Carbine PW (15Rnd)</label>
						<description>Caliber: .30 Carbine. 15-round detachable mag. Select-Fire.\n\nThis variant has a 15-round magazine.</description>
						<commonality>0.04</commonality> <!-- 1 in 25 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/M2_Carbine_PW_15Rnd</texPath>
						</graphicData>
						<statOffsets>
							<Mass>-0.2</Mass> <!-- 15Rnd M1 Carbine Mag -->
						</statOffsets>
					</li>
				</variants>
			</li>
		</comps>
	</ThingDef>
	
</Defs>