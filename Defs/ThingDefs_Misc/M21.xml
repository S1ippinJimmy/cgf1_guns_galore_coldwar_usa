<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_SemiBattleRifle_T1">
		<defName>CGF1_MWP_M21_</defName>
		<label>M21</label>
		<description>Caliber: 7.62x51mm NATO. 20-round detachable mag. Semi-Automatic.</description>
		<graphicData>
			<texPath>CGF1/Gun/M21</texPath>
			<drawSize>1.05</drawSize>
		</graphicData>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T8_AtomicAgeFirearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>80</Steel>
			<ComponentIndustrial>8</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>45000</WorkToMake>
			<Mass>4.5</Mass>
			<AccuracyTouch>0.55</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.75</AccuracyMedium>
			<AccuracyLong>0.60</AccuracyLong>
			<RangedWeapon_Cooldown>1.1</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>40</equippedAngleOffset>
		<weaponTags>
			<li>CGF1_Rifle_Marksman</li>
			<li>CGF1_Rifle_Marksman_Advanced</li>
		</weaponTags>
		<weaponClasses>
			<li>LongShots</li>
			<li>RangedHeavy</li>
		</weaponClasses>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarUSA</li>
			<li>CGF1_GunsGalore_ColdWarUSA_Sniper</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_762x51mmNATO_Rifle</defaultProjectile>
				<warmupTime>1.8</warmupTime>
				<range>39.9</range>
				<soundCast>CGF1_MWP_SFX_Rifle_Semi2</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalshThree</def>
				<drawSize>(0.8,0.8)</drawSize>
				<offsets>
					<li>(0.7,0.06)</li>
				</offsets>
			</li>
		</modExtensions>
		<generateCommonality>0.20</generateCommonality> <!-- Common -->
		
		<comps>
			<li Class="WeaponVariants.CompProperties_WeaponVariants">
				<generateBaseWeapon>true</generateBaseWeapon>
				<variants>
					<li>
						<defName>CGF1_MWP_M21_SD</defName>
						<label>M21 (SD)</label>
						<description>Caliber: 7.62x51mm NATO. 20-round detachable mag. Semi-Automatic.\n\nThis variant has an attached suppressor.</description>
						<commonality>0.08</commonality> <!-- 1 in 12.5 -->
						<graphicData>
							<texPath>CGF1/Gun/Variant/M21_SD</texPath>
							<drawSize>1.25</drawSize>
						</graphicData>
						<statOffsets>
							<Mass>0.2</Mass> <!-- Suppressor -->
						</statOffsets>
						<equippedStatOffsets>
							<HuntingStealth>0.5</HuntingStealth> <!-- 0.5 for suppressors -->
						</equippedStatOffsets>
						<verbModifiers>
							<li>
								<verbIndex>0</verbIndex>
								<soundCast>CGF1_MWP_SFX_Rifle_Semi_SD1</soundCast>
								<muzzleFlashScale>-8</muzzleFlashScale>
							</li>
						</verbModifiers>
						<modExtensions>
							<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
								<def>CGF1_MF_StandardMuzzleFlashSD</def>
								<drawSize>(0.3,0.3)</drawSize>
								<offsets>
									<li>(0.81,0.07)</li>
								</offsets>
							</li>
						</modExtensions>
					</li>
				</variants>
			</li>
		</comps>
	</ThingDef>
</Defs>